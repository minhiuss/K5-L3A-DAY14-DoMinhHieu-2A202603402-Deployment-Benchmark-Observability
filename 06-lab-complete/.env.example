# ============================================================
# Biến môi trường của agent (tiêu chí 9) — KHÔNG ghi secret thật ở đây.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# ============================================================

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — đặt chuỗi bí mật riêng trong .env / trên dashboard Railway, Render
AGENT_API_KEY=

# Redis — rate limit + cost guard lưu ở đây
REDIS_URL=redis://localhost:6379/0

# Giới hạn
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
